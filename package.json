{
  "name": "pond-extension",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker",
    "lint": "eslint src tests scripts worker",
    "format": "prettier --write src tests scripts worker manifests public data docs *.json *.md *.mjs",
    "format:check": "prettier --check src tests scripts worker manifests public data docs *.json *.md *.mjs",
    "test": "vitest run",
    "test:browser": "node scripts/browser-smoke.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm build",
    "eval": "node scripts/eval-intelligence.mjs",
    "serve": "node scripts/serve.mjs",
    "build:server": "node scripts/build-server.mjs",
    "build:production": "node scripts/build.mjs --production",
    "start": "node .server/main.mjs",
    "test:live": "node scripts/live-e2e.mjs",
    "test:live:firefox": "node scripts/live-e2e-firefox.mjs",
    "deploy:worker": "wrangler deploy",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260926.1",
    "@eslint/js": "^10.0.1",
    "@puppeteer/browsers": "^3.2.3",
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "jsdom": "^26.0.0",
    "playwright": "^1.55.0",
    "prettier": "^3.6.0",
    "puppeteer-core": "^25.12.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.141.0",
    "zod": "^3.25.0"
  },
  "packageManager": "pnpm@11.19.0"
}
